// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.NVarChar(255)
  name         String   @db.NVarChar(100)
  passwordHash String   @db.NVarChar(255)
  createdAt    DateTime @default(now())

  memberships   ProjectMember[]
  assignedTasks Task[]              @relation("TaskAssignee")
  statusChanges TaskStatusHistory[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String   @db.NVarChar(200)
  keyPrefix   String   @unique @db.NVarChar(10)
  taskCounter Int      @default(0)
  createdAt   DateTime @default(now())

  members ProjectMember[]
  sprints Sprint[]
  tasks   Task[]

  githubLink    GithubLink?
  pullRequests  PullRequest[]
  webhookEvents WebhookEvent[]
}

model ProjectMember {
  projectId Int
  userId    Int
  role      String @default("member") @db.NVarChar(20)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Sprint {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String   @db.NVarChar(100)
  goal      String?  @db.NVarChar(500)
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("PLANNED") @db.NVarChar(20)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model Task {
  id          Int       @id @default(autoincrement())
  projectId   Int
  number      Int
  title       String    @db.NVarChar(300)
  description String?   @db.NVarChar(Max)
  status      String    @default("TODO") @db.NVarChar(20)
  points      Int?
  sprintId    Int?
  assigneeId  Int?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  history  TaskStatusHistory[]

  pullRequests TaskPullRequest[]

  @@unique([projectId, number])
  @@index([projectId, status])
}

model TaskStatusHistory {
  id          Int      @id @default(autoincrement())
  taskId      Int
  fromStatus  String?  @db.NVarChar(20)
  toStatus    String   @db.NVarChar(20)
  source      String   @db.NVarChar(20)
  changedById Int?
  changedAt   DateTime @default(now())

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId, changedAt])
}

model GithubLink {
  id            Int      @id @default(autoincrement())
  projectId     Int      @unique
  repoFullName  String   @unique @db.NVarChar(200)
  webhookSecret String   @db.NVarChar(100)
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PullRequest {
  id          Int      @id @default(autoincrement())
  projectId   Int
  number      Int
  title       String   @db.NVarChar(300)
  state       String   @db.NVarChar(20)
  url         String   @db.NVarChar(500)
  authorLogin String?  @db.NVarChar(100)
  lastEventAt DateTime
  createdAt   DateTime @default(now())

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskPullRequest[]

  @@unique([projectId, number])
}

model TaskPullRequest {
  taskId        Int
  pullRequestId Int

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([taskId, pullRequestId])
}

model WebhookEvent {
  id         Int      @id @default(autoincrement())
  deliveryId String   @unique @db.NVarChar(100)
  projectId  Int
  event      String   @db.NVarChar(50)
  action     String?  @db.NVarChar(50)
  outcome    String   @db.NVarChar(30)
  receivedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, receivedAt])
}